# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://console.groq.com (AI severity from text + photo, chat-to-report).
# Without it the app still works: severity falls back to category baseline + keywords.
GROQ_API_KEY=
# Optional model overrides
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Any long random string
JWT_SECRET=change-me-to-a-long-random-string
# true = OTP codes are printed in the server console instead of sent by SMS
OTP_MOCK_MODE=true
# Optional: protect /api/cron/escalate with "Authorization: Bearer <secret>"
CRON_SECRET=
